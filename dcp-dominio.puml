' =====================================================================
' PLANOS E ADESÃO
' =====================================================================
package "Planos e Adesão" {
  class Plano {
    -nome : String
    -nivel : int
    -valorMensal : double
    -limiteAulasMes : int
    -permiteDependentes : boolean
    -empresasQueOferecem : List<Empresa>
    -estabelecimentosLiberados : List<Estabelecimento> ''n tem no codigo ainda
    -modalidadesLiberadas : List<Modalidade> ''n tem no codigo ainda
    +getNome() : String
    +getNivel() : int
    +getValorMensal() : double
    +getLimiteAulasMes() : int
    +permiteDependentes() : boolean
    +oferecerPara(e : Empresa) : void
    +ehOferecidoPor(e : Empresa) : boolean
    ''Falta:
    +libera(e : Estabelecimento) : boolean
    +libera(m : Modalidade) : boolean
    +liberar(e : Estabelecimento) : void
    +liberar(m : Modalidade) : void
    +getEmpresasQueOferecem() : List<Empresa>
    +getEstabelecimentosLiberados() : List<Estabelecimento>
    +getModalidadesLiberadas() : List<Modalidade>
  }

  class Adesao {
    -aluno : Aluno
    -plano : Plano
    -dataInicio : LocalDate
    -dataFim : LocalDate
    -situacao : SituacaoAdesao
    {static} +cadastrarBeneficiario(f : Funcionario, p : Plano) : Adesao
    {static} +trocarPlano(atual : Adesao, novo : Plano) : Adesao
    +incluirDependente(d : Dependente) : Adesao
    +estaAtiva() : boolean
    +encerrar() : void
    +suspender() : void
    +reativar() : void
    +getAluno() : Aluno
    +getPlano() : Plano
    +getDataInicio() : LocalDate
    +getDataFim() : LocalDate
    +getSituacao() : SituacaoAdesao
    ''Falta:
    +registrarCheckIn(e : Estabelecimento, lat : double, lng : double, ultimo : CheckIn) : CheckIn
    +reservarVaga(a : Aula, reservasMes : int) : Reserva
  }
}

' =====================================================================
' CADASTRO E REDE
' =====================================================================
package "Cadastro e Rede" {
  class Empresa {
    -razaoSocial : String
    -cnpj : String
    -dataContrato : LocalDate
    -limiteDependentes : int
    -diaVencimentoFatura : int
    -funcionarios : List<Funcionario>
    +incluirFuncionario(f : Funcionario) : void
    +removerFuncionario(f : Funcionario) : void
    +getTotalFuncionarios() : int
    +getTotalDependentes() : int
    +getTotalBeneficiarios() : int
    +possuiFuncionario(f : Funcionario): boolean
    +getFuncionarios() : List<Funcionario>
    +getRazaoSocial() : String
    +getCnpj() : String
    +getDataContrato() : LocalDate
    +getLimiteDependentes() : int
    +getDiaVencimentoFatura() : int
    ''Falta:
    +bloquearBeneficiarios() : void
    +desbloquearBeneficiarios() : void
  }

  abstract class Aluno {
    -nome : String
    -cpf : String
    -email : String
    -dataCadastro : LocalDate
    -situacao : SituacaoAluno
    +estaAtivo() : boolean
    +bloquear() : void
    +reativar() : void
    +inativar() : void
    {abstract} +ehElegivel() : boolean
    {abstract} +getEmpresaVinculada() : Empresa
    +getNome() : String
    +getCpf() : String
    +getEmail() : String
    +getDataCadastro() : LocalDate
    +getSituacao() : SituacaoAluno
  }

  together {
    class Funcionario {
      -matricula : String
      -dataAdmissao : LocalDate
      -empresa : Empresa
      -dependentes : List<Dependente>
      +ehElegivel() : boolean
      ~desvincular() : void
      +vincularDependente(d : Dependente) : void
      +removerDependente(d : Dependente) : void
      +getDependentes() : List<Dependente>
      +getMatricula() : String
      +getDataAdmissao() : LocalDate
      +getEmpresaVinculada() : Empresa
    }

    class Dependente {
      -grauParentesco : String
      -responsavel : Funcionario
      +ehElegivel() : boolean
      +getGrauParentesco() : String
      +getResponsavel() : Funcionario
      +getEmpresaVinculada() : Empresa
    }
  }

  abstract class Estabelecimento {
    -nomeFantasia : String
    -cnpj : String
    -situacaoCredenciamento : SituacaoCredenciamento
    -valorPorCheckIn : double
    -endereco : Endereco ''n tem no codigo ainda
    -aulas : List<Aula> ''n ta implementado
    -modalidades : List<Modalidade>
    -instrutores : List<Instrutor>
    +aprovarCredenciamento() : void
    +suspenderCredenciamento() : void
    +estaCredenciado() : boolean
    +adicionarModalidade(nome : String, descricao : String) : Modalidade
    +removerModalidade(m : Modalidade) : void
    +oferece(m : Modalidade) : boolean
    +contratarInstrutor(nome : String, registro : String, especialidade : String) : Instrutor
    +desligarInstrutor(i : Instrutor) : void
    +getNomeFantasia() : String
    +getCnpj() : String
    +getValorPorCheckIn() : double
    +getSituacaoCredenciamento() : SituacaoCredenciamento
    +getModalidades() : List<Modalidade>
    +getInstrutores() : List<Instrutor>
    ''Falta:
    +estaNoRaio(lat : double, lng : double) : boolean
    +getEndereco() : Endereco
    +agendarAula(inicio : LocalDateTime, duracao : Duration, capacidade : int, m : Modalidade, i : Instrutor) : Aula
    +getAulas() : List<Aula>
  }

  together {
    class Academia {
      -funciona24Horas : boolean
      +isFunciona24Horas() : boolean
    }
    class Estudio {
      -capacidadePadraoTurma : int
      +getCapacidadePadraoTurma() : int
    }
    class Quadra {
      -coberta : boolean
      +isCoberta() : boolean
    }
  }
  
  ''Falta a classe endereço na implementação!
  class Endereco {
    -logradouro : String
    -numero : String
    -bairro : String
    -cidade : String
    -cep : String
    -latitude : double
    -longitude : double
    +distanciaAte(lat : double, lng : double) : double
    +getLogradouro() : String
    +getNumero() : String
    +getBairro() : String
    +getCidade() : String
    +getCep() : String
    +getLatitude() : double
    +getLongitude() : double
  }

  class Modalidade {
    -nome : String
    -descricao : String
    +getNome() : String
    +getDescricao() : String
  }

  class Instrutor {
    -nome : String
    -registro : String
    -especialidade : String
    -estabelecimento : Estabelecimento
    +getNome() : String
    +getRegistro() : String
    +getEspecialidade() : String
    +getEstabelecimento() : Estabelecimento
    +trabalhaEm(e : Estabelecimento) : boolean
  }
}

' =====================================================================
' ACESSO E AGENDA
' =====================================================================
package "Acesso e Agenda" {
  class Aula {
    -dataHoraInicio : LocalDateTime
    -duracao : Duration
    -capacidadeMaxima : int
    -cancelada : boolean
    -estabelecimento : Estabelecimento
    -modalidade : Modalidade
    -instrutor : Instrutor
    -reservas : List<Reserva> ''n tem no codigo ainda
    {static}-validar(inicio : LocalDateTime, capacidade : int, e : Estabelecimento, m : Modalidade, i : Instrutor) : void
    +atribuirInstrutor(i : Instrutor) : void
    +alterarCapacidade(c : int) : void
    +reagendar(inicio : LocalDateTime, d : Duration) : void
    +cancelar() : void
    +estaCancelada() : boolean
    +jaComecou() : boolean
    +getCapacidadeMaxima() : int
    +getDataHoraInicio() : LocalDateTime
    +getDuracao() : Duration
    +getEstabelecimento() : Estabelecimento
    +getModalidade() : Modalidade
    +getInstrutor() : Instrutor
    ''Fazer no codigo
    +reservar(al : Aluno) : Reserva
    +getReservas() : List<Reserva>
    +vagasDisponiveis() : int
  }

  ''falta no codigo
  class Reserva {
    -dataHoraReserva : LocalDateTime
    -situacao : SituacaoReserva
    -penalizada : boolean
    -aluno : Aluno
    -aula : Aula
    +cancelar(momento : LocalDateTime) : void
    +marcarUtilizada() : void
    +getDataHoraReserva() : LocalDateTime
    +getSituacao() : SituacaoReserva
    +isPenalizada() : boolean
    +getAluno() : Aluno
    +getAula() : Aula
    +registrarFalta() : void
  }

   ''Falta no codigo:
  class CheckIn {
    -dataHora : LocalDateTime
    -latitudeOrigem : double
    -longitudeOrigem : double
    -situacaoValidacao : SituacaoCheckIn
    -codigo : String
    -aluno : Aluno
    -aula : Aula
    -estabelecimento : Estabelecimento
    +validar() : void
    +recusar(motivo : String) : void
    +expirou(momento : LocalDateTime) : boolean
    -motivoRecusa : String
    +getDataHora() : LocalDateTime
    +getLatitudeOrigem() : double
    +getLongitudeOrigem() : double
    +getSituacaoValidacao() : SituacaoCheckIn
    +getCodigo() : String
    +getAluno() : Aluno
    +getAula() : Aula
    +getEstabelecimento() : Estabelecimento
    +expirar() : void
  }

   ''Falta no codigo:
  class RelatorioEngajamento {
    -mesReferencia : YearMonth
    -taxaAdesao : double
    -totalCheckIns : int
    -mediaCheckInsPorFuncionario : double
    -empresa : Empresa
    {static} +gerar(e : Empresa, adesoes : List<Adesao>, checkIns : List<CheckIn>, mes : YearMonth) : RelatorioEngajamento
    +getMesReferencia() : YearMonth
    +getTaxaAdesao() : double
    +getTotalCheckIns() : int
    +getMediaCheckInsPorFuncionario() : double
    +getEmpresa() : Empresa
  }
}
