  -estabelecimentos : List<Estabelecimento>
  -alunos : List<Aluno>
  -reservas : List<Reserva>
  -planos : List<Plano>
  -adesoes : List<Adesao>
  -aulas : List<Aula>
  -checkIns : List<CheckIn>
  -faturas : List<Fatura>
  -repasses : List<Repasse>
  -relatorios : List<RelatorioEngajamento>
  -notificacoes : List<Notificacao>
  .. Plano ..
  +incluirFuncionario(empresaId : int, nome : String, matricula : String, planoId : int) : void
  +incluirDependente(empresaId : int, funcionarioId : int, nome : String, grauParentesco : String) : void
  +removerFuncionario(empresaId : int, funcionarioId : int) : void
  +trocarPlano(empresaId : int, funcionarioId : int, planoId : int) : Adesao
  -adesaoVigente(empresaId : int, funcionarioId : int) : Adesao
  ''Falta Implementar/Validar : ..
  +assinarPlano(alunoId : int, planoId : int) : Adesao
  +cancelarAssinatura(alunoId : int) : void

  .. Agendamento ..
  +agendar(estabelecimentoId : int, modalidadeId : int, instrutorId : int, inicio : String, duracaoMin : long, capacidade : int) : void
  +trocarInstrutor(aulaId : int, instrutorId : int) : void
  +alterarCapacidade(aulaId : int, capacidade : int) : void
  +cancelar(aulaId : int) : void
  ''Falta implementar: ..
  +reservarVaga(alunoId : int, aulaId : int) : Reserva
  +cancelarReserva(alunoId : int, reservaId : int) : void
  +consultarCalendario(alunoId : int) : List<Reserva>

  .. Controle de Acesso ..
  ''falta tudo 
  +buscarEstabelecimentos(alunoId : int, latitude : double, longitude : double, raio : double, modalidade : String, tipo : String, dia : LocalDate, somenteCobertos : boolean) : List<Estabelecimento>
  +realizarCheckIn(alunoId : int, aulaId : int, estabelecimentoId : int, latitude : double, longitude : double) : CheckIn
  +validarCheckIn(codigo : String) : void

  .. Gestão de Parceiros ..
  ''EstabelecimentoService
  +adicionarModalidade(estabelecimentoId : int, nome : String, descricao : String) : void
  +removerModalidade(estabelecimentoId : int, modalidadeId : int) : void
  +contratarInstrutor(estabelecimentoId : int, nome : String, registro : String, especialidade : String) : void
  +desligarInstrutor(estabelecimentoId : int, instrutorId : int) : void
  ''GestaoParceirosService
  +cadastrarEstabelecimento(nome : String, tipo : String, valorPorCheckIn : double) : void
  +aprovarCredenciamento(estabelecimentoId : int) : void
  +suspenderCredenciamento(estabelecimentoId : int) : void
  +contratarEmpresa(razaoSocial : String, limiteDependentes : int, diaVencimento : int) : void
  +criarPlano(nome : String, nivel : int, valorMensal : double, limiteAulasMes : int, permiteDependentes : boolean) : void
  +oferecerPlano(empresaId : int, planoId : int) : void
  +liberarEstabelecimento(planoId : int, estabelecimentoId : int) : void
  +liberarModalidade(planoId : int, estabelecimentoId : int, modalidadeId : int) : void

  .. Análise ..
  ''Falta e nao será feito, apenas planejado
  +consultarRelatorio(empresaId : int, mes : YearMonth) : RelatorioEngajamento
  +consultarExtrato(estabelecimentoId : int, mes : YearMonth) : Repasse
  +recomendarAulas(alunoId : int) : List<Aula>

  .. Rotinas de Sistema ..
