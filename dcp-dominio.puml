package "Financeiro" {
  class Fatura {
    -mesReferencia : YearMonth
    -valorTotal : double
    -dataVencimento : LocalDate
    -situacao : SituacaoFatura
    -empresa : Empresa
    +estaEmAtraso(hoje : LocalDate, tolerancia : int) : boolean
    -dataPagamento : LocalDate
    {static} +gerar(e : Empresa, adesoes : List<Adesao>, mes : YearMonth) : Fatura
    +registrarPagamento(data : LocalDate) : void
    +getMesReferencia() : YearMonth
    +getValorTotal() : double
    +getDataVencimento() : LocalDate
    +getSituacao() : SituacaoFatura
    +getEmpresa() : Empresa
  }

  class Repasse {
    -mesReferencia : YearMonth
    -quantidadeCheckIns : int
    -valorTotal : double
    -estabelecimento : Estabelecimento
    -checkins : List<CheckIn>
    {static} +gerar(e : Estabelecimento, checkIns : List<CheckIn>, mes : YearMonth) : Repasse
    +getMesReferencia() : YearMonth
    +getQuantidadeCheckIns() : int
    +getValorTotal() : double
    +getEstabelecimento() : Estabelecimento
    +getCheckIns() : List<CheckIn>
  }
}

